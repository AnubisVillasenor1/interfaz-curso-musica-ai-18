# Copy to .env in ops/audio-core; never commit actual secrets.
# Supabase project values must point to the intended Play & Go project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Generate independent random secrets (for example: openssl rand -hex 32).
GATEWAY_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
AUDIOCORE_INTERNAL_TOKEN=replace-with-a-different-at-least-32-random-bytes

# MinIO root credentials are for bootstrap/admin only, not worker access.
MINIO_ROOT_USER=replace-me-admin
MINIO_ROOT_PASSWORD=replace-with-long-random-password
# Provision a dedicated worker identity with only s3:PutObject, s3:GetObject and s3:ListBucket
# on the tamv-audio bucket. Pre-create the bucket with the admin account.
S3_ACCESS_KEY=replace-with-least-privilege-worker-user
S3_SECRET_KEY=replace-with-least-privilege-worker-secret
S3_BUCKET=tamv-audio

MUSICGEN_MODEL=facebook/musicgen-small
MUSICGEN_MAX_DURATION_SECONDS=30
WORKER_CONCURRENCY=1
WORKER_MAX_JOBS_PER_MINUTE=6
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=replace-with-long-random-password
