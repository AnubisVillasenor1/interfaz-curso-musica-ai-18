# MusicGen weights have separate license terms; validate them before commercial use.
FROM python:3.10-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/models/huggingface
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 build-essential git && rm -rf /var/lib/apt/lists/*
COPY services/audiocore/requirements-musicgen.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt
COPY services/audiocore/musicgen_service.py ./musicgen_service.py
RUN useradd --system --uid 10001 musicgen && mkdir -p /models && chown -R musicgen:musicgen /app /models
USER musicgen
EXPOSE 8001
CMD ["uvicorn", "musicgen_service:app", "--host", "0.0.0.0", "--port", "8001"]
