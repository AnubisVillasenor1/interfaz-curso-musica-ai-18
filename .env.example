# Public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional local Ollama instance used only for music arrangement planning.
# In hosted deployments, use a private reachable service URL, not a browser-exposed URL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Jamendo API client ID; Internet Archive search works without this.
JAMENDO_CLIENT_ID=
