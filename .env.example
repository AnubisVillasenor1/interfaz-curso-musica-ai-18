# Plantilla de entorno · Play and Go (TAMV ONLINE)
# Copia este archivo a `.env.local` y rellena los valores. Nunca comitees `.env.local`.
# Ninguna de estas claves debe escribirse en el código fuente.
#
# Clasificación:
#   [obligatorio]  sin la variable, la función que la usa falla cerrada (503).
#   [opcional]     la función se desactiva o degrada de forma explícita.
# La aplicación arranca sin secretos: cada servicio falla cerrado y
# `/api/health` reporta `degraded=true` sin revelar valores.
# No existe una validación global al arrancar porque Next evalúa módulos en
# build y en runtime; la comprobación vive en la ruta que necesita el servicio.

# ─────────────────────────────────────────────
# Dominio público · obligatorio para cobrar y para el SEO
# ─────────────────────────────────────────────
# Origen canónico de la app. Stripe exige que el retorno del checkout apunte a
# un dominio permitido en el Dashboard: con el header `Origin` de la petición
# la Session fallaba, y con comodín cualquier tercero conseguía una redirección
# a `?checkout=success` en su propio subdominio. Sin esto, /api/checkout
# responde 503 a propósito en lugar de perder al cliente en un limbo.
# También alimenta metadataBase, robots.txt y sitemap.xml.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Supabase · obligatorio para que la app arranque
# ─────────────────────────────────────────────
# URL del proyecto: Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://SU-PROYECTO.supabase.co

# Clave pública. El código acepta indistintamente la anon legada (JWT `eyJ...`)
# o su relevo `sb_publishable_...`; basta con definir una de las dos.
# Ojo: si ambas quedan vacías, `proxy.ts` falla y ninguna ruta responde.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave service_role: solo servidor, omite el prefijo NEXT_PUBLIC para que
# no termine en el bundle del navegador. La usan el webhook de Stripe y el
# callback de generación, que escriben fuera de cualquier sesión de usuario.
SUPABASE_SERVICE_ROLE_KEY=

# Destino de la confirmación de correo al registrarse desde desarrollo local.
# Vacío = usa el origen de la ventana + /auth/callback.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ─────────────────────────────────────────────
# Pagos del curso · sin esto, /api/checkout responde 503
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─────────────────────────────────────────────
# Proveedor de generación musical · sin proveedor, /api/generate responde 503
# ─────────────────────────────────────────────
# Proveedor activo: huggingface | replicate | fal | local | suno (histórico).
# Sin variable se autodetecta (API_KEY → suno, LOCAL_MUSIC_API_URL → local, ...).
# El motor `local` del navegador (Tone.js) no usa ninguna de estas claves.
MUSIC_PROVIDER=local

# Hugging Face (gratis, token en huggingface.co/settings/tokens)
HUGGINGFACEHUB_API_TOKEN=
HUGGINGFACE_MUSIC_MODEL=facebook/musicgen-small

# Replicate / fal.ai (de pago por corrida; el modelo es un slug o hash de versión)
REPLICATE_API_TOKEN=
REPLICATE_ACE_STEP_MODEL=
FAL_KEY=
FAL_ACE_STEP_MODEL=

# Servidor propio Ace-Step/YuE/DiffRhythm (ver music-engine/)
LOCAL_MUSIC_API_URL=http://127.0.0.1:8000
LOCAL_MUSIC_API_KEY=
LOCAL_MUSIC_MODEL=ace-step

# Proveedor histórico. Bearer token del proveedor. SUNO_API_URL es opcional:
# sin valor usa https://api.sunoapi.org/api/v1/generate.
API_KEY=
SUNO_API_URL=

# Secreto para firmar nuestras propias URLs de callback. El proveedor no firma
# sus notificaciones, así que `/api/generate/callback` rechaza todo lo que no
# lleve el HMAC del songId; sin esta variable el generate de pago se detiene y
# marca la canción como error, porque dejar el endpoint abierto era permitir que
# cualquiera reemplazara el audio de otro usuario.
# Genera uno largo y aleatorio: openssl rand -hex 32
GENERATOR_CALLBACK_SECRET=

# ─────────────────────────────────────────────
# Guía conversacional del curso · opcional
# ─────────────────────────────────────────────
# Sin AI_AGENT_API_KEY, `/api/agent` responde con el contenido real del curso y
# la burbuja lo dice; nunca finge ser un modelo. Con clave, usa cualquier
# endpoint compatible con OpenAI. BazaarLink (gateway OpenAI-compatible):
# gratis recomendado nvidia/nemotron-3.5-lightning-free (costo $0.00/M);
# barato qwen/qwen3.7-flash ($0.03/$0.13 por 1M). Ver docs/INFRA-BAZAARLINK.md.
AI_AGENT_API_KEY=
AI_AGENT_BASE_URL=https://api.bazaarlink.ai/v1
AI_AGENT_MODEL=nvidia/nemotron-3.5-lightning-free

# ─────────────────────────────────────────────
# Control de solicitudes · Redis distribuido (Upstash / Vercel KV)
# ─────────────────────────────────────────────
# Producción exige estas dos variables: sin ellas las rutas con límite
# responden 503 a propósito para no quedar sin techo. Desarrollo, preview y CI
# usan un limitador en memoria por proceso, que no es global entre instancias.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sólo emergencia en producción: acepta memoria local (no distribuida) y la
# registra como modo degradado. Déjalo en false salvo incidente declarado.
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false
# Declara producción en self-hosting fuera de Vercel. En Vercel se detecta con
# VERCEL_ENV=production; en local/CI puede quedar vacío.
PLAY_AND_GO_ENV=development

# ─────────────────────────────────────────────
# Voz sintética · Kokoro self-hosted primero, Gateway como respaldo en Vercel
# ─────────────────────────────────────────────
# URL privada del contenedor services/voice-identity; nunca se envía al navegador.
VOICE_IDENTITY_URL=http://127.0.0.1:8001
# Debe coincidir con AUDIOCORE_INTERNAL_TOKEN dentro del servicio local.
AUDIOCORE_INTERNAL_TOKEN=
# Preset Kokoro permitido para cada idioma. El preset no clona a una persona.
KOKORO_VOICE_ID=
KOKORO_VOICE_ID_EN=

# ─────────────────────────────────────────────
# TAMV-AudioCore · opcional
# ─────────────────────────────────────────────
# Servicio externo de análisis DSP (C++/NumPy). Sin URL, `/api/music/analyze`
# responde 503 y el navegador sigue analizando en local con `analysis-core.mjs`.
# Vercel Functions no ejecuta el contenedor: apunta a un host con CPU real.
TAMV_AUDIO_CORE_URL=
# Token Bearer que exige el servicio cuando no escucha en loopback.
TAMV_AUDIO_CORE_TOKEN=

# ─────────────────────────────────────────────
# Opcionales
# ─────────────────────────────────────────────
# Instancia local de Ollama, usada solo para planear el arreglo.
# En despliegues hosted usa una URL privada alcanzable, nunca expuesta al navegador.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Client ID de Jamendo; la búsqueda en Internet Archive funciona sin esto.
JAMENDO_CLIENT_ID=

# ─────────────────────────────────────────────
# MusicGen asíncrono · servicio self-hosted (no se ejecuta dentro de Vercel)
# ─────────────────────────────────────────────
# URL alcanzable desde el runtime Next.js. En Vercel usa conectividad privada
# o un reverse proxy HTTPS con token, rate limit y restricciones de red.
AUDIO_QUEUE_GATEWAY_URL=
GATEWAY_INTERNAL_TOKEN=
